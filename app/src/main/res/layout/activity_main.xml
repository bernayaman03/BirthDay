<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gün Hesaplayıcı"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/etGun"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Gün (Örn: 15)"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etAy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ay (Örn: 03)"
        android:inputType="number"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etYil"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Yıl (Örn: 2000)"
        android:inputType="number"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnHesapla"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="KAÇ GÜNDÜR HAYATTAYIM?"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvSonuc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sonuç burada görünecek"
        android:textSize="20sp"
        android:layout_marginTop="32dp"
        android:textColor="#2196F3"
        android:textStyle="italic" />

</LinearLayout>